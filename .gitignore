# ==========================================
# Big Data Real Estate Analytics .gitignore
# ==========================================

# Large Raw Datasets (Auto-downloaded via scripts/01_ingest_data.py)
data/raw/*
!data/raw/.gitkeep

# Large Cleaned Hadoop Full Output (>100MB exceeds GitHub push limit)
data/clean/full/clean_sales.tsv

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# OS Artifacts
.DS_Store
Thumbs.db
__MACOSX/
*.tmp

# VS Code & IDE settings
.vscode/
.idea/
